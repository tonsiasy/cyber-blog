# Server Configuration
PORT=8080
GIN_MODE=debug

# Database Configuration (Driver: sqlite / postgres)
DB_DRIVER=sqlite
DB_SQLITE_PATH=cyber_blog.db

# PostgreSQL Configuration (For Remote Ali Server)
DB_HOST=localhost
DB_PORT=5432
DB_USER=blog_user
DB_PASSWORD=your_secure_password
DB_NAME=cyber_blog
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# JWT Configuration
JWT_SECRET=cyber-blog-web3-super-secret-key-2026
JWT_EXPIRATION_HOURS=72

# Cloudflare R2 Configuration (Optional / S3 Compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
